{
  "name": "woerds-docs",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && pagefind --site out --output-path out/_pagefind && python3 tools/docs/site.py postbuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test remark/*.test.mjs"
  },
  "overrides": {
    "zod": "4.3.6"
  },
  "dependencies": {
    "next": "16.4.4",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "pagefind": "1.6.0",
    "typescript": "5.9.3"
  }
}
